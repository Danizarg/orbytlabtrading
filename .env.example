# ORBYT environment variables
# ---------------------------------------------------------------------------
# Copy to .env.local for local development. On Vercel, add them under
# Project → Settings → Environment Variables, then redeploy.
#
# EVERY VARIABLE IS OPTIONAL. With none set, ORBYT runs entirely on keyless
# public sources: GeckoTerminal, DEX Screener and Jupiter (called from each
# visitor's browser), the PumpPortal free stream, publicnode, and the public
# Solana RPC (server-side). Keys upgrade freshness, coverage and rate limits.
#
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only secrets. They are
# read in route handlers and never shipped to the browser. Never give a secret
# a NEXT_PUBLIC_ prefix, and never commit a filled-in .env file.
# ---------------------------------------------------------------------------

# --- Solana RPC (server) ------------------------------------------------------
# Server-side JSON-RPC used for bonding curves, mint info, wallet balances,
# wallet activity and transaction parsing.
# Default: https://api.mainnet-beta.solana.com. It is heavily rate-limited
# (10 req / 10 s for getTransaction and getSignaturesForAddress), blocks
# browsers, and is not meant for production.
# Any private endpoint works (Helius, Triton, QuickNode, …). If unset and
# HELIUS_API_KEY is set, ORBYT uses Helius mainnet RPC automatically.
SOLANA_RPC_URL=

# --- Helius (server) ------------------------------------------------------------
# Enables: near-real-time token trade feeds (server polling + transaction
# parsing), fast wallet history for PnL (getTransactionsForAddress), and holder
# lists (getTokenLargestAccounts, blocked on the public RPC).
# Get a key: https://dashboard.helius.dev. The free plan is 1M credits/month
# and 10 RPC req/s.
HELIUS_API_KEY=

# --- Birdeye (server) ---------------------------------------------------------
# Enables: 1s/15s candles, token trade history, holder lists, holder tags
# (snipers / insiders / bundlers), meme-launch lists for Pulse.
# Get a key: https://bds.birdeye.so. The free Standard plan is 30k CU/month at
# 1 rps, so paid plans are recommended for production.
BIRDEYE_API_KEY=

# --- Solana Tracker (server) --------------------------------------------------
# Enables: Pulse launch lists (latest / graduating / graduated), risk metrics
# (snipers, insiders, bundlers, top-10, dev holdings), 1s/5s/15s candles, trades.
# Get a key: https://www.solanatracker.io/data-api. Free is 10k requests/month
# at 3 rps.
SOLANATRACKER_API_KEY=

# --- CoinGecko on-chain / GeckoTerminal (server) -------------------------------
# Enables: server-side GeckoTerminal data with higher limits, plus (paid plans
# only) second-level candles and cross-pool token trades.
# Get a key: https://www.coingecko.com/en/api/pricing
# COINGECKO_API_PLAN: "demo" (free Demo key, api.coingecko.com) or "pro" (any
# paid plan, pro-api.coingecko.com). Default: demo.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo

# --- Jupiter (server) ----------------------------------------------------------
# Enables: server-side token discovery/market data and quotes with a shared,
# CDN-cached key instead of each visitor's keyless 0.5 rps quota.
# Get a key: https://developers.jup.ag/portal. The free tier is 1 rps; the
# Developer tier or higher is recommended for a public site.
JUPITER_API_KEY=

# --- Browser-visible endpoints (public, safe to expose) ----------------------
# Browser JSON-RPC for light on-chain reads (bonding-curve accounts).
# Default: https://solana-rpc.publicnode.com (keyless, allows browser origins).
# If you use a keyed URL here it WILL be visible to users; only use a
# separate, domain-restricted, low-budget key.
NEXT_PUBLIC_SOLANA_BROWSER_RPC_URL=
# Browser WebSocket for wallet-tracker log subscriptions.
# Default: wss://solana-rpc.publicnode.com (best effort; may drop messages,
# so ORBYT also reconciles by polling). Same exposure warning as above.
NEXT_PUBLIC_SOLANA_WS_URL=
# PumpPortal data stream (free: new pump.fun launches + migrations).
# Default: wss://pumpportal.fun/api/data
NEXT_PUBLIC_PUMPPORTAL_WS_URL=

# --- Site ------------------------------------------------------------------------
# Optional override of the site-wide public deposit address shown in the Deposit
# dialog. Default: the address configured in src/config/site.ts.
NEXT_PUBLIC_DEPOSIT_ADDRESS=
